# Copy to .env for local development. Never commit .env — TECHSTACK.md A13.
# Real secrets live in the deployment platform's secret store, not in files.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# OWNER role — runs migrations only. Owns the schema, therefore BYPASSES RLS.
# Never used by the running application.
DATABASE_URL_OWNER=postgres://erp_owner:owner_dev_password@localhost:5432/erp

# APP role — used by the application at runtime. Deliberately NOT the table
# owner, so FORCE ROW LEVEL SECURITY cannot be bypassed. See TECHSTACK.md A3.
DATABASE_URL=postgres://erp_app:app_dev_password@localhost:5432/erp

# Separate database for integration tests. Dropped and recreated per run.
DATABASE_URL_TEST=postgres://erp_owner:owner_dev_password@localhost:5432/erp_test

# ---------------------------------------------------------------------------
# Auth (better-auth) — database-backed sessions, NOT stateless JWTs.
# §25 requires immediate revocation; Phase 01.1 gate asserts it.
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=generate-a-32-byte-random-value-for-real-environments
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Files — the attachment store (REQ-IMPROVE-001 OP-3)
# ---------------------------------------------------------------------------
# Where uploaded documents are kept. SET THIS IN PRODUCTION: unset, the store
# is <cwd>/var/attachments, and the standalone server's cwd is inside .next,
# which every deploy replaces. Live: /var/lib/qs-erp/attachments.
ATTACHMENT_DIR=

# Object storage (S3 / Cloudflare R2) — TECHSTACK.md A7; not used by the
# attachment store yet.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development

# Primary ledger currency — §1.1. IQD is not configurable at runtime.
LEDGER_CURRENCY=IQD
REPORTING_CURRENCY=USD

# The business day (REQ-HARDEN-001 HD7): every document date, period check
# and "today" is this zone's, whatever the server's clock is set to.
ERP_TIMEZONE=Asia/Baghdad

# The most rows one export file may carry (REQ-IMPROVE-001 OP-9); 20000 unless set.
# EXPORT_ROW_CAP=20000

# Local test servers only: serve the screens the catalogue has not delivered.
# SHOW_UNBUILT_SCREENS=1

# ---------------------------------------------------------------------------
# E-mail (REQ-HARDEN-001 HARDEN-3) — the delivery job's SMTP account
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---------------------------------------------------------------------------
# Observability — TECHSTACK.md A14, §23; REQ-IMPROVE-001 OP-5
# ---------------------------------------------------------------------------
# debug | info | warn | error. Every line is JSON with the request id; the
# error page shows the digest that is on the line (src/instrumentation.ts).
LOG_LEVEL=info
# Read by nothing yet (B-IM-5): the exporters are not wired.
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Operations (REQ-IMPROVE-001 OP-1, OP-7) — set by deploy.sh / the host, not here
# ---------------------------------------------------------------------------
# DEPLOYMENT_ID   exported by deploy.sh into the build; /healthz reports it
# BACKUP_ROOT     where backup.sh writes (default /root/erp-backups)
# JOB_STATE_DIR   where run-job.sh records each job's last exit (default <app>/var/jobs)
# JOB_LOG_DIR     the jobs' logs (default /var/log/qs-erp)
