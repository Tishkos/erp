{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qimah Al-Safinah ERP",
  "version": "1.0.0",
  "identifier": "com.qsgroups.erp",
  "build": {
    "frontendDist": "../desktop/boot"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Qimah Al-Safinah",
    "copyright": "© 2026 Qimah Al-Safinah",
    "category": "Business",
    "shortDescription": "Qimah Al-Safinah ERP",
    "longDescription": "The Qimah Al-Safinah ERP, as a Windows application. The ledger, the documents and every permission stay on the server; this is the window onto them.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Arabic"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://erp.qs-groups.com/desktop/latest.json"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}
